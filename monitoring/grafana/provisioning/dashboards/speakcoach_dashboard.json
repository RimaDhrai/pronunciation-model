      "targets": [
        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "rate(pg_stat_database_tup_fetched{job=\"postgres\",datname=\"pronunciation_db\"}[5m])", "legendFormat": "Tuples lus/s", "refId": "A" },
