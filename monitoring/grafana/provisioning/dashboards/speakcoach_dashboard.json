        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "histogram_quantile(0.95, sum by(le, handler) (rate(http_request_duration_seconds_bucket{job=\"fastapi\"}[5m])))", "legendFormat": "p95 {{handler}}", "refId": "B" },
