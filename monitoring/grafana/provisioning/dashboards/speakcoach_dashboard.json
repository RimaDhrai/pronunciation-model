      "targets": [
        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "histogram_quantile(0.50, sum by(le, uri) (rate(http_server_requests_seconds_bucket{job=\"spring-boot\"}[5m])))", "legendFormat": "p50 {{uri}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "histogram_quantile(0.95, sum by(le, uri) (rate(http_server_requests_seconds_bucket{job=\"spring-boot\"}[5m])))", "legendFormat": "p95 {{uri}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "histogram_quantile(0.99, sum by(le, uri) (rate(http_server_requests_seconds_bucket{job=\"spring-boot\"}[5m])))", "legendFormat": "p99 {{uri}}", "refId": "C" }
      ],
      "title": "Latence HTTP Spring Boot (p50 / p95 / p99)",
      "type": "timeseries"
    },
