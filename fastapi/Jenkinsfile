pipeline {
    agent any

    environment {
        GIT_REPO     = 'https://github.com/Talan-PFE2026/pronunciation.git'
        GIT_BRANCH   = 'fastapi'
        IMAGE_NAME   = 'speakcoach-fastapi'
        SONAR_HOST_URL = 'http://host.docker.internal:9000'
        SONAR_TOKEN    = credentials('sonarqube-token')
        PROJECT_KEY    = 'SpeakCoach-FastAPI'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        // ── 1. CHECKOUT ──────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
                echo "Build #${env.BUILD_NUMBER} — branche: ${GIT_BRANCH}"
            }
        }

        // ── 2. INSTALL DEPENDENCIES ──────────────────────────────────────────
        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m venv venv || python -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip -q
                    pip install -r requirements.txt -q
                    pip install pytest pytest-cov -q
                '''
            }
        }

        // ── 3. TESTS + COUVERTURE ────────────────────────────────────────────
        stage('Tests') {
            steps {
                sh '''
                    . venv/bin/activate
                    pytest tests/ \
                        --tb=short \
                        -q \
                        --cov=. \
                        --cov-report=xml:coverage.xml \
                        --cov-report=term-missing \
                        --cov-config=.coveragerc
                '''
            }
            post {
                always {
                    // Publie le rapport de couverture Python dans Jenkins
                    publishHTML(target: [
                        allowMissing:           true,
                        alwaysLinkToLastBuild:  true,
                        keepAll:                true,
                        reportDir:              'htmlcov',
                        reportFiles:            'index.html',
                        reportName:             'FastAPI Coverage Report'
                    ])
                }
            }
        }

        // ── 4. ANALYSE SONARQUBE ─────────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        sonar-scanner \
                            -Dsonar.projectKey=${PROJECT_KEY} \
                            -Dsonar.projectName="SpeakCoach FastAPI" \
                            -Dsonar.sources=. \
                            -Dsonar.exclusions=venv/**,__pycache__/**,tests/**,htmlcov/** \
                            -Dsonar.python.coverage.reportPaths=coverage.xml \
                            -Dsonar.python.version=3.11 \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.token=${SONAR_TOKEN}
                    """
                }
            }
        }

        // ── 5. QUALITY GATE ───────────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── 6. DOCKER BUILD ───────────────────────────────────────────────────
        stage('Docker Build') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} ."
                echo "Image Docker ${IMAGE_NAME}:${env.BUILD_NUMBER} construite"
            }
        }
    }

    post {
        success {
            echo "Pipeline FastAPI réussi — Build #${env.BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline FastAPI échoué — Build #${env.BUILD_NUMBER}"
        }
        always {
            cleanWs(cleanWhenFailure: false)
        }
    }
}
