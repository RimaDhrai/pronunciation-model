        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "node_memory_MemTotal_bytes", "legendFormat": "RAM totale", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "speakcoach-prometheus" }, "expr": "node_memory_MemAvailable_bytes", "legendFormat": "RAM disponible", "refId": "C" }
